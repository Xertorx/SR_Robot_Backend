PORT=3000
NODE_ENV=development
JWT_SECRET=sr_robot_super_secret_jwt_key_2026
DB_URI=mongodb://localhost:27017/sr_robot_db
CURRENCY=COP
COUNTRY_CODE=CO
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=5
PAYMENT_WEBHOOK_SECRET=cambia_este_secreto
# false = los pagos quedan PENDING hasta que llegue el webhook de la pasarela
PAYMENT_AUTO_APPROVE=true
TZ_OFFSET=-05:00
UPLOADS_DIR=uploads
# Producción: SEED_DATA=false + ADMIN_EMAIL/ADMIN_PASSWORD crean solo un admin inicial
SEED_DATA=true
EXPOSE_OTP=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Orígenes permitidos del front, separados por coma (vacío = todos)
CORS_ORIGINS=
